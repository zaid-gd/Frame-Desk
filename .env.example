# Convex deployment URL used by the Next.js client.
# Running `npm run dev` can populate this value for your development deployment.
NEXT_PUBLIC_CONVEX_URL=

# Clerk publishable key exposed to the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Clerk secret key used only by the Next.js server.
CLERK_SECRET_KEY=

# Clerk issuer domain used by Convex to validate authentication tokens.
# Set this in your Convex deployment environment. CLERK_FRONTEND_API_URL is
# preferred; CLERK_JWT_ISSUER_DOMAIN is supported as a fallback.
CLERK_FRONTEND_API_URL=
# CLERK_JWT_ISSUER_DOMAIN=
