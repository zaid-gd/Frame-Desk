{
  "name": "cutlab-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "convex dev --start \"npm run dev:next\"",
    "dev:next": "next dev",
    "convex:dev": "convex dev",
    "build": "next build",
    "check": "npm run lint && npm run build && npm audit --omit=dev",
    "check:full": "npm run check && npm run test:team && npm run test:files && npm run verify:team && npm run verify:browser && npm run verify:prod",
    "start": "next start",
    "lint": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "verify:team": "node scripts/verify-team.mjs",
    "test:team": "vitest run convex/team.test.ts",
    "test:files": "vitest run convex/projectFiles.test.ts",
    "verify:team:live": "node scripts/verify-team-live.mjs",
    "verify:browser": "node scripts/verify-browser-smoke.mjs",
    "verify:prod": "node scripts/verify-production.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.4.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.5",
    "@mui/material": "^7.3.5",
    "@mui/material-nextjs": "^7.3.5",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "convex": "^1.39.1",
    "next": "^16.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "overrides": {
    "postcss": "^8.5.15",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "convex-test": "^0.0.53",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
